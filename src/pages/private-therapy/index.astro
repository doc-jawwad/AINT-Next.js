---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HtmlContent from "../../components/HtmlContent.astro";
import { getPageHtml } from "../../lib/pages";
import { staticPageTitle, staticPageDescription } from "../../lib/page-meta";

const slug = "private-therapy";
const html = getPageHtml(slug);
const title = staticPageTitle(slug);
const description = staticPageDescription(slug);

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://aintfoundationcic.co.uk/private-therapy#webpage",
      "url": "https://aintfoundationcic.co.uk/private-therapy",
      "name": "Private Therapy | AINT Foundation CIC",
      "description": "Personalised 1:1 trauma-informed therapy sessions.",
      "isPartOf": { "@id": "https://aintfoundationcic.co.uk/#website" },
      "breadcrumb": { "@id": "https://aintfoundationcic.co.uk/private-therapy#breadcrumb" },
      "inLanguage": "en-GB"
    },
    {
      "@type": "MedicalTherapy",
      "@id": "https://aintfoundationcic.co.uk/#private-therapy",
      "name": "Private Therapy — AINT Foundation CIC",
      "description": "Trauma-informed private therapy for individuals, couples, children, and groups using the AINT Model (Avery Integrative Non-Judgemental Therapy). Available in person and online.",
      "provider": { "@id": "https://aintfoundationcic.co.uk/#organization" },
      "url": "https://aintfoundationcic.co.uk/private-therapy",
      "offers": [
        {
          "@type": "Offer",
          "name": "Individual Therapy Session",
          "price": "70.00",
          "priceCurrency": "GBP",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "70.00",
            "priceCurrency": "GBP",
            "unitText": "per session"
          }
        },
        {
          "@type": "Offer",
          "name": "Couples Therapy Session",
          "price": "85.00",
          "priceCurrency": "GBP"
        },
        {
          "@type": "Offer",
          "name": "SOS Therapy Session",
          "price": "80.00",
          "priceCurrency": "GBP"
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://aintfoundationcic.co.uk/private-therapy#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://aintfoundationcic.co.uk/" },
        { "@type": "ListItem", "position": 2, "name": "Private Therapy", "item": "https://aintfoundationcic.co.uk/private-therapy" }
      ]
    }
  ]
});
---

<BaseLayout title={title} description={description} schema={schema}>
  <HtmlContent html={html} />
</BaseLayout>
