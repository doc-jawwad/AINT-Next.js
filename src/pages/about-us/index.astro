---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HtmlContent from "../../components/HtmlContent.astro";
import { getPageHtml } from "../../lib/pages";
import { staticPageTitle, staticPageDescription } from "../../lib/page-meta";

const slug = "about";
const html = getPageHtml(slug);
const title = staticPageTitle(slug);
const description = staticPageDescription(slug);

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": "https://aintfoundationcic.co.uk/about-us#webpage",
      "url": "https://aintfoundationcic.co.uk/about-us",
      "name": "About Us | AINT Foundation CIC",
      "description": "Meet the team and mission behind AINT Foundation CIC.",
      "isPartOf": { "@id": "https://aintfoundationcic.co.uk/#website" },
      "about": { "@id": "https://aintfoundationcic.co.uk/#organization" },
      "breadcrumb": { "@id": "https://aintfoundationcic.co.uk/about-us#breadcrumb" },
      "inLanguage": "en-GB"
    },
    {
      "@type": "Person",
      "@id": "https://aintfoundationcic.co.uk/#dr-trish-avery",
      "name": "Dr Trish Avery",
      "jobTitle": "Founder, AINT Foundation CIC",
      "description": "Founder of AINT Foundation CIC and developer of the AINT Model — Avery Integrative Non-Judgemental Therapy. Leads the clinical direction and practitioner training programmes.",
      "worksFor": { "@id": "https://aintfoundationcic.co.uk/#organization" },
      "url": "https://aintfoundationcic.co.uk/about-us"
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://aintfoundationcic.co.uk/about-us#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://aintfoundationcic.co.uk/" },
        { "@type": "ListItem", "position": 2, "name": "About Us", "item": "https://aintfoundationcic.co.uk/about-us" }
      ]
    }
  ]
});
---

<BaseLayout absoluteTitle={true} title={title} description={description} schema={schema}>
  <HtmlContent html={html} />
</BaseLayout>
