---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HtmlContent from "../../components/HtmlContent.astro";
import { getPageHtml } from "../../lib/pages";
import { staticPageTitle, staticPageDescription } from "../../lib/page-meta";

const slug = "community-support";
const html = getPageHtml(slug);
const title = staticPageTitle(slug);
const description = staticPageDescription(slug);

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://aintfoundationcic.co.uk/community-support#webpage",
      "url": "https://aintfoundationcic.co.uk/community-support",
      "name": "Community Support | AINT Foundation CIC",
      "description": "Low-cost and free community wellbeing support.",
      "isPartOf": { "@id": "https://aintfoundationcic.co.uk/#website" },
      "breadcrumb": { "@id": "https://aintfoundationcic.co.uk/community-support#breadcrumb" },
      "inLanguage": "en-GB"
    },
    {
      "@type": "Service",
      "@id": "https://aintfoundationcic.co.uk/#community-support",
      "name": "Community Support — AINT Foundation CIC",
      "description": "Affordable and free emotional wellbeing support for individuals who cannot access private therapy. Delivered through the AINT Model.",
      "provider": { "@id": "https://aintfoundationcic.co.uk/#organization" },
      "url": "https://aintfoundationcic.co.uk/community-support",
      "offers": {
        "@type": "Offer",
        "name": "Community Wellbeing Session",
        "price": "10.00",
        "priceCurrency": "GBP",
        "description": "Subsidised sessions from £10. Free sessions also available."
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://aintfoundationcic.co.uk/community-support#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://aintfoundationcic.co.uk/" },
        { "@type": "ListItem", "position": 2, "name": "Community Support", "item": "https://aintfoundationcic.co.uk/community-support" }
      ]
    }
  ]
});
---

<BaseLayout title={title} description={description} schema={schema}>
  <HtmlContent html={html} />
</BaseLayout>
