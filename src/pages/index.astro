---

<BaseLayout
  absoluteTitle={true}
  title="AINT Foundation CIC | Therapy, Training & Community Wellbeing"
  description="Trauma-informed therapy, community wellbeing support and practitioner training built around the AINT Model. Without judgement. Without shame. Without fear."
  loadFrontInteractions={true}
  schema={schema}
>
  <HtmlContent html={html} />
</BaseLayout>
