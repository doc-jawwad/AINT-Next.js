---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": "https://aintfoundationcic.co.uk/contact-us#webpage",
      "url": "https://aintfoundationcic.co.uk/contact-us",
      "name": "Contact Us | AINT Foundation CIC",
      "description": "Reach AINT Foundation CIC by email or phone for compassionate, non-judgemental support or information about our services.",
      "isPartOf": { "@id": "https://aintfoundationcic.co.uk/#website" },
      "about": { "@id": "https://aintfoundationcic.co.uk/#organization" },
      "breadcrumb": { "@id": "https://aintfoundationcic.co.uk/contact-us#breadcrumb" },
      "inLanguage": "en-GB"
    },
    {
      "@type": "Organization",
      "@id": "https://aintfoundationcic.co.uk/#organization",
      "name": "AINT Foundation CIC",
      "url": "https://aintfoundationcic.co.uk",
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+443000301309",
        "email": "info@aintfoundationcic.co.uk",
        "contactType": "customer support",
        "availableLanguage": "English",
        "areaServed": "GB"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://aintfoundationcic.co.uk/contact-us#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://aintfoundationcic.co.uk/" },
        { "@type": "ListItem", "position": 2, "name": "Contact Us", "item": "https://aintfoundationcic.co.uk/contact-us" }
      ]
    }
  ]
});
---

<BaseLayout
  title="Contact Us"
  description="Contact AINT Foundation CIC by phone or email. A safe, confidential point of contact for support, therapy enquiries, training and partnership information."
  schema={schema}
>
  <div class="section-wrap" style="padding-top: 48px; padding-bottom: 80px;">
    <div style="max-width: 720px; margin: 0 auto;">
      <div class="s-kicker" style="color: var(--sage-d);">
        Contact
      </div>
      <h1 class="s-title">Contact us</h1>
      <p class="s-body" style="margin-bottom: 32px;">
        You can reach AINT Foundation CIC directly at{" "}
        <a href="mailto:info@aintfoundationcic.co.uk" style="font-weight: 600;">
          info@aintfoundationcic.co.uk
        </a>{" "}
        — a safe, confidential point of contact for anyone seeking compassionate,
        non‑judgmental support or information about our services.
      </p>

      <div
        style="display: grid; gap: 32px; grid-template-columns: minmax(0, 1fr);"
      >
        <div
          style="background: var(--white); padding: 40px; border-radius: 20px; box-shadow: 0 8px 32px rgba(24,36,28,0.04); border: 1px solid rgba(92, 138, 111, 0.1);"
        >
          <h2
            style="font-family: 'Cormorant Garamond', serif; font-size: 28px; color: var(--char); margin-bottom: 20px;"
          >
            Send a message
          </h2>
          <ContactForm source="contact" submitLabel="Send message" />
        </div>

        <div
          style="padding: 32px; border-radius: 16px; background: rgba(92,138,111,0.05); border: 1px solid rgba(92,138,111,0.15);"
        >
          <h2
            style="font-family: 'Cormorant Garamond', serif; font-size: 24px; color: var(--char); margin-bottom: 16px;"
          >
            Contact
          </h2>
          <ul style="list-style: none; padding: 0; margin: 0; line-height: 1.9; color: var(--text-m);">
            <li>
              <a href="mailto:info@aintfoundationcic.co.uk">info@aintfoundationcic.co.uk</a>
            </li>
            <li>
              <a href="tel:+443000301309">+44 3000 301309</a>
            </li>
            <li>Location: United Kingdom</li>
            <li>AINT Foundation CIC</li>
            <li>Company Number: 17193409</li>
          </ul>

          <h3 style="margin-top: 28px; font-size: 16px; color: var(--char);">Crisis Support Notice</h3>
          <p style="font-size: 14px; color: var(--text-m); margin-bottom: 8px;">
            We are not a crisis or emergency service.
          </p>
          <p style="font-size: 14px; color: var(--text-m); margin: 0;">
            <strong>If you need immediate help:</strong> Samaritans:{" "}
            <a href="tel:116123">116 123</a> · NHS: <a href="tel:111">111</a> · Emergency:{" "}
            <a href="tel:999">999</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
