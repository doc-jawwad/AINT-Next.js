---
import BaseLayout from "../layouts/BaseLayout.astro";
import HtmlContent from "../components/HtmlContent.astro";
import ShareButtons from "../components/ShareButtons.astro";
import { getAllPosts, getPostBySlug } from "../lib/posts";
import { pageExists } from "../lib/pages";

export function getStaticPaths() {
  return getAllPosts()
    .filter((p) => !pageExists(p.slug))
    .map((p) => ({
      params: { slug: p.slug },
    }));
}

const { slug } = Astro.params;
const post = getPostBySlug(slug!);

if (!post) {
  throw new Error(`Post not found for slug: ${slug}`);
}

const date = new Date(post.date).toLocaleDateString("en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const description = post.excerpt.replace(/<[^>]+>/g, "").slice(0, 160);
const sharePath = `/${post.slug}`;
---

<BaseLayout title={post.title} description={description} breadcrumbLabel={post.title}>
  <header class="page-header">
    <div class="s-kicker" style="justify-content: center;">Blog</div>
    <h1 style="text-align: center; max-width: 820px; margin: 0 auto;">{post.title}</h1>
    <p style="text-align: center; color: var(--text-l); margin-top: 12px;">{date}</p>
    <ShareButtons title={post.title} url={sharePath} class="share-bar--header" />
  </header>
  <section class="section-wrap" style="padding-top: 20px;">
    {
      post.featuredImage?.url ? (
        <img
          src={post.featuredImage.url}
          alt={post.featuredImage.alt || post.title}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          style="width: 100%; max-width: 900px; margin: 0 auto 40px; display: block; border-radius: 20px; aspect-ratio: 16 / 9; object-fit: cover;"
        />
      ) : null
    }
    <HtmlContent html={post.content} class="blog-prose" />
    <ShareButtons title={post.title} url={sharePath} class="share-bar--footer" />
    <div style="text-align: center; margin-top: 40px;">
      <a href="/blog" class="btn-s">← Back to Blog</a>
    </div>
  </section>
</BaseLayout>
