---
import { buildBreadcrumbs, type Crumb } from "../lib/breadcrumbs";

interface Props {
  /** Override the final crumb label (e.g. blog post title). */
  currentLabel?: string;
  crumbs?: Crumb[] | null;
}

const { currentLabel, crumbs: crumbsProp } = Astro.props;
const crumbs =
  crumbsProp !== undefined
    ? crumbsProp
    : buildBreadcrumbs(Astro.url.pathname, { currentLabel });

const show = Boolean(crumbs && crumbs.length >= 2);
const site =
  Astro.site?.toString().replace(/\/$/, "") || "https://aintfoundationcic.co.uk";

const jsonLd = show
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: crumbs!.map((crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: crumb.label,
        ...(crumb.href
          ? {
              item: crumb.href.startsWith("http")
                ? crumb.href
                : `${site}${crumb.href}`,
            }
          : {}),
      })),
    }
  : null;
---

{
  show && (
    <nav class="site-breadcrumbs" aria-label="Breadcrumb">
      <div class="site-breadcrumbs-inner">
        <ol class="bc-list">
          {crumbs!.map((crumb, index) => {
            const isLast = index === crumbs!.length - 1;
            return (
              <li class="bc-item">
                {index > 0 && (
                  <span class="bc-sep" aria-hidden="true">
                    <svg width="6" height="10" viewBox="0 0 6 10" fill="none">
                      <path
                        d="M1 1l4 4-4 4"
                        stroke="currentColor"
                        stroke-width="1.25"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                )}
                {crumb.href && !isLast ? (
                  <a class="bc-link" href={crumb.href}>
                    {index === 0 ? (
                      <span class="bc-home">
                        <svg
                          class="bc-home-icon"
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="none"
                          aria-hidden="true"
                        >
                          <path
                            d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1v-9.5Z"
                            stroke="currentColor"
                            stroke-width="1.6"
                            stroke-linejoin="round"
                          />
                        </svg>
                        <span>Home</span>
                      </span>
                    ) : (
                      crumb.label
                    )}
                  </a>
                ) : (
                  <span class="bc-current" aria-current="page">
                    {crumb.label}
                  </span>
                )}
              </li>
            );
          })}
        </ol>
      </div>
    </nav>
  )
}

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
