---
interface Props {
  title: string;
  url?: string;
  /** Optional class for spacing variants (e.g. share-bar--footer) */
  class?: string;
}

const { title, url, class: className } = Astro.props;

const shareUrl = url
  ? new URL(url, Astro.site).href
  : new URL(Astro.url.pathname, Astro.site).href;

const encodedUrl = encodeURIComponent(shareUrl);
const encodedTitle = encodeURIComponent(title);

const links = [
  {
    id: "facebook",
    label: "Share on Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    path: "M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z",
  },
  {
    id: "linkedin",
    label: "Share on LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    path: "M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z",
  },
  {
    id: "x",
    label: "Share on X",
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
    path: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.743l7.227-8.451L1.25 2.25h7.414l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z",
  },
  {
    id: "whatsapp",
    label: "Share on WhatsApp",
    href: `https://api.whatsapp.com/send?text=${encodeURIComponent(`${title} ${shareUrl}`)}`,
    path: "M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z",
  },
  {
    id: "email",
    label: "Share by email",
    href: `mailto:?subject=${encodedTitle}&body=${encodeURIComponent(`I thought you might find this useful:\n\n${title}\n${shareUrl}`)}`,
    path: "M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z",
  },
] as const;
---

<div class:list={["share-bar", className]} data-share-url={shareUrl}>
  <p class="share-bar-label">Share this article</p>
  <div class="share-bar-links" role="group" aria-label="Share this article">
    {
      links.map((link) => (
        <a
          class={`share-btn share-btn--${link.id}`}
          href={link.href}
          aria-label={link.label}
          target={link.id === "email" ? undefined : "_blank"}
          rel={link.id === "email" ? undefined : "noopener noreferrer"}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={link.path} />
          </svg>
        </a>
      ))
    }
    <button
      type="button"
      class="share-btn share-btn--copy"
      data-share-copy
      aria-label="Copy link"
    >
      <svg class="share-icon-link" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
      </svg>
      <svg class="share-icon-check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden>
        <path d="M20 6L9 17l-5-5" />
      </svg>
      <span class="share-copy-label" hidden>Copied</span>
    </button>
  </div>
</div>

<script>
  function initShareCopy(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>("[data-share-copy]").forEach((btn) => {
      if (btn.dataset.bound === "1") return;
      btn.dataset.bound = "1";

      btn.addEventListener("click", async () => {
        const bar = btn.closest<HTMLElement>(".share-bar");
        const url = bar?.dataset.shareUrl || window.location.href;
        const linkIcon = btn.querySelector<SVGElement>(".share-icon-link");
        const checkIcon = btn.querySelector<SVGElement>(".share-icon-check");
        const label = btn.querySelector<HTMLElement>(".share-copy-label");

        try {
          await navigator.clipboard.writeText(url);
        } catch {
          const input = document.createElement("input");
          input.value = url;
          document.body.appendChild(input);
          input.select();
          document.execCommand("copy");
          input.remove();
        }

        btn.classList.add("is-copied");
        btn.setAttribute("aria-label", "Link copied");
        if (linkIcon) linkIcon.hidden = true;
        if (checkIcon) checkIcon.hidden = false;
        if (label) label.hidden = false;

        window.setTimeout(() => {
          btn.classList.remove("is-copied");
          btn.setAttribute("aria-label", "Copy link");
          if (linkIcon) linkIcon.hidden = false;
          if (checkIcon) checkIcon.hidden = true;
          if (label) label.hidden = true;
        }, 2000);
      });
    });
  }

  initShareCopy();
  document.addEventListener("astro:page-load", () => initShareCopy());
</script>
